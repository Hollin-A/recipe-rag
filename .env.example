# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Which embedder to use: "voyage" (real) or "fake" (offline bag-of-words, no API key needed).
EMBEDDER=voyage

# Voyage AI: https://dashboard.voyageai.com/ → API keys.
# Without a payment method on the account, rate limits are very low (free tokens still apply with one).
VOYAGE_API_KEY=
# Embedding model. voyage-4 returns 1024-dimensional vectors and includes 200M free tokens.
# Check https://docs.voyageai.com/docs/pricing: older models (e.g. voyage-3.5) get no free tokens.
VOYAGE_MODEL=voyage-4

# Postgres from docker-compose.yml. This default matches the compose file, so you only need it to point elsewhere.
DATABASE_URL=postgres://recipe:recipe@localhost:5433/recipe
